{
  "name": "@sage/evaluation",
  "version": "1.0.0",
  "private": true,
  "description": "D8-D9 test suite, baselines, and ablation study for the SAGE pipeline. Runs entirely in-process (no AWS Lambda invocation, no cdk deploy) against the real agent handler functions, Groq for LLM calls, and Qdrant/MongoDB for retrieval.",
  "main": "dist/run-experiments.js",
  "types": "src/run-experiments.ts",
  "scripts": {
    "experiment": "tsx src/run-experiments.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "calibrate:retrieval": "tsx src/retrieval/calibrate.ts",
    "rt11": "tsx src/rt11/run.ts"
  },
  "dependencies": {
    "@sage/shared-types": "*",
    "@sage/catalogue": "*",
    "@sage/secrets": "*",
    "@sage/agent-input-guard": "*",
    "@sage/agent-intent": "*",
    "@sage/agent-broker": "*",
    "@sage/agent-negotiator": "*",
    "@sage/agent-reviewer": "*",
    "@sage/agent-explainer": "*",
    "@sage/conductor": "*",
    "dotenv": "^16.4.5",
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "vitest": "^5.0.0"
  }
}
