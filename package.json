{
  "name": "sage",
  "version": "1.0.0",
  "private": true,
  "description": "SAGE (Service-Agent Graph Ecosystem): a multi-agent AI system that turns a plain-English request into a verified, explained and audited cloud-service choice.",
  "license": "Apache-2.0",
  "author": "Divik Bhaskar",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build --workspace=packages/shared-types && npm run build --workspace=packages/secrets && npm run build --workspace=packages/audit && npm run build --workspace=packages/llm && npm run build --workspace=packages/catalogue",
    "pretest": "npm run prepare --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm run prepare --silent",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:agents": "npm run build -w packages --if-present && npm run build -w agents --if-present",
    "experiment": "npm run experiment --workspace=evaluation",
    "security-report": "npm run security-report --workspace=agents/input-guard",
    "backend:status": "node scripts/backend.mjs status",
    "backend:pause": "node scripts/backend.mjs pause",
    "backend:resume": "node scripts/backend.mjs resume",
    "build:dashboard-api": "npm run build:api --workspace=apps/dashboard",
    "catalogue:refs": "tsx scripts/catalogue-references.ts",
    "audit:verify": "tsx packages/audit/scripts/verify.ts",
    "load-test": "node scripts/load-test.mjs",
    "catalogue:ingest": "tsx scripts/catalogue-ingest.ts",
    "catalogue:import": "tsx scripts/catalogue-import.ts",
    "catalogue:workbook": "python scripts/catalogue-workbook.py",
    "catalogue:probe": "tsx scripts/catalogue-probe.ts"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "agents/*",
    "packages/*",
    "infra/*",
    "evaluation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hikunokyojin/SAGE_Cloud_Project_2026.git"
  },
  "bugs": {
    "url": "https://github.com/Hikunokyojin/SAGE_Cloud_Project_2026/issues"
  },
  "homepage": "https://github.com/Hikunokyojin/SAGE_Cloud_Project_2026#readme",
  "keywords": [
    "multi-agent",
    "llm",
    "aws",
    "aws-cdk",
    "serverless",
    "rag",
    "typescript",
    "explainable-ai",
    "agentic-ai"
  ],
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@sage/shared-types": "^0.0.1"
  }
}
